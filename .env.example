# ============================================================
# FYT360 平台部署级环境变量（复制为 .env 后填写）
# 决策 #25：.env 只放平台级配置；站点级凭据（小程序 appid/secret、
# 蚂蚁星球 apikey/secret、微信支付商户参数）一律由后台按站点维护，
# 落 site / provider_config 表，不进 .env。
# ============================================================

# --- 核心必填（缺一即终止部署） ---
# CloudBase 环境 ID（控制台 → 环境设置）
TCB_ENV=
TCB_SECRET_ID=
TCB_SECRET_KEY=
# CloudBase AI 网关 Key（控制台 → AI → 大模型 → API Key）
# 用途：AI 装修/换肤（hy3）+ 无 PG 直连串时的 exec-pgsql HTTP 网关模式
TCB_API_KEY=
# 用于派生会话 token 与定时任务 HMAC，务必用 openssl rand -hex 32 生成
JWT_SECRET=
ADMIN_INIT_PASSWORD=

# --- 迁移/种子用（平台级基础设施配置，连接串取自 CloudBase 控制台「云数据库」） ---
DATABASE_URL=postgresql://user:password@host:5432/fyt360

# --- 可选 ---
# 对外域名（微信支付回调 / 上传文件 URL 拼接用；不填默认 https://mk.fyt360.cn）
# PUBLIC_BASE_URL=https://mk.fyt360.cn
# 蚂蚁星球 apikey（仅 deploy/scripts 探针/拉取脚本用；站点级凭据一律走 provider_config 表）
# HJK_APIKEY=

# --- 定时任务（deploy/scripts/function-deploy.mjs 全自动部署，以下仅用于改周期/换域名）---
# 不填则用代码内默认值：ordersync 30min、checkin-remind 每日 09:00、ordersweep 5min
# ORDERSYNC_TRIGGER=0 */30 * * * * *
# CHECKIN_REMIND_TRIGGER=0 0 9 * * * *
# ORDERSWEEP_TRIGGER=0 */5 * * * * *
# 换正式域名时覆盖（须已在云托管白名单登记）
# CRON_BASE_URL=https://your-domain.com
# ORDERSYNC_URL=https://your-domain.com/api/jobs/ordersync/cron
# CHECKIN_REMIND_URL=https://your-domain.com/api/jobs/checkin-remind/cron
# ORDERSWEEP_URL=https://your-domain.com/api/jobs/ordersweep/cron

