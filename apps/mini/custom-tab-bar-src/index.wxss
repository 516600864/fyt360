/* mini-01 设计稿 1:1（紧凑版）：
   图标+文字包进圆角方块（激活=玫红底白图标白字，参考币安式 tab）；
   粗描边奶油胶囊 + 独立 FAB 圆钮（全站搜索）。整体缩一号更精致。
   glass=胶囊奶油白90%+backdrop-filter 增强；classic=同布局实底。 */

.tab-wrap {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  z-index: 999;
  display: flex;
  align-items: center;
  /* 本地钉住默认色板（决策#30 定稿 1:1）：page{} theme.css 的同名变量会级联进本组件，
     若不在此重设，无主题时兜底值会被全局默认顶掉（胶囊变纯白/文字变浅）。
     有主题时 sync() 写入的根内联 style 优先级更高，照常覆盖。 */
  --fyt-primary: #e8336d;
  --fyt-primary-dark: #a31245;
  --fyt-surface: #fbf3e4;
  --fyt-text: #2b2420;
  --fyt-text-2: #5f594e;
  --fyt-bg-glass: rgba(251, 243, 228, 0.9);
}

/* ---------- 胶囊（4 tab 容器） ---------- */
.tab-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: var(--fyt-surface, #fbf3e4);
  border: 3rpx solid var(--fyt-text, #2b2420); /* VI 粗描边 */
  border-radius: 999rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 26rpx rgba(43, 36, 32, 0.13);
}
.tab-wrap.glass .tab-bar {
  background: var(--fyt-bg-glass, rgba(251, 243, 228, 0.9));
  backdrop-filter: blur(36rpx) saturate(1.4);
  -webkit-backdrop-filter: blur(36rpx) saturate(1.4);
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
}
/* 图标+文字包进同一方块；未激活透明，激活玫红 */
.tab-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 10rpx 16rpx 8rpx;
  border-radius: 24rpx;
  min-width: 108rpx;
}
.tab-item.active .tab-pill {
  background: var(--fyt-primary, #e8336d);
  box-shadow: 0 6rpx 16rpx rgba(232, 51, 109, 0.38);
}
.tab-icon {
  width: 40rpx;
  height: 40rpx;
}
.tab-dot {
  font-size: 30rpx;
  font-weight: 900;
  color: #fff;
  line-height: 40rpx;
}
/* 表情图标（后台未传图片时的点选表情）：与图片 icon 同视觉重量 */
.tab-dot.emoji {
  font-size: 34rpx;
  font-weight: 400;
}
.tab-name {
  font-size: 21rpx;
  color: var(--fyt-text-2, #5f594e);
  font-weight: 500;
  line-height: 26rpx;
}
.tab-item.active .tab-name {
  color: #fff;
  font-weight: 700;
}

/* ---------- FAB 全站搜索：独立圆钮（胶囊外右侧，等比正圆） ---------- */
.fab-btn {
  flex: none;
  align-self: center; /* 垂直居中（tab-wrap 已 center，双保险） */
  width: 108rpx;      /* 宽=高=胶囊总高（86+16+6=108），保持正圆；调胶囊高度须同步改这两个值 */
  height: 108rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--fyt-primary, #c21a56), var(--fyt-primary-dark, #8e0f3c));
  border: 3rpx solid var(--fyt-text, #2b2420);
  box-shadow: 0 8rpx 22rpx rgba(142, 15, 60, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box; /* 描边计入 108，防止撑破正圆 */
}
.fab-ic {
  width: 56rpx;
  height: 56rpx;
}
.fab-ic-txt {
  font-size: 44rpx;
  line-height: 1;
}
